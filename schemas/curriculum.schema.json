{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/re-speak/podo-curriculum/schemas/curriculum.schema.json",
  "title": "Curriculum",
  "description": "Repo-level configuration. One per repository.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "podo.curriculum/v1" },
    "kind": { "const": "Curriculum" },
    "metadata": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "owners": { "type": "array", "items": { "type": "string" } }
      }
    },
    "spec": {
      "type": "object",
      "required": ["classType", "bookFormat", "languages", "environments"],
      "additionalProperties": false,
      "properties": {
        "classType": { "const": "PODO" },
        "bookFormat": { "const": "HTML" },
        "languages": {
          "type": "object",
          "minProperties": 1,
          "description": "Keyed by the courses/ subdirectory name.",
          "additionalProperties": {
            "type": "object",
            "required": ["langType"],
            "additionalProperties": false,
            "properties": {
              "langType": {
                "type": "string",
                "pattern": "^[A-Z]{2,4}$",
                "description": "GT_CLASS_COURSE.LANG_TYPE. KR for Korean (Language.KOREAN.simpleCode in podo-backend)."
              },
              "audience": { "type": "string" },
              "displayName": { "type": "string" }
            }
          }
        },
        "environments": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["lemonboardApi", "grapeSyncApi", "gcsBucket", "gcsPrefix", "publicBaseUrl"],
            "additionalProperties": false,
            "properties": {
              "lemonboardApi": { "type": "string", "format": "uri" },
              "grapeSyncApi": { "type": "string", "format": "uri" },
              "gcsBucket": { "type": "string" },
              "gcsPrefix": { "type": "string" },
              "publicBaseUrl": { "type": "string", "format": "uri" }
            }
          }
        },
        "sharedRuntime": {
          "type": "object",
          "description": "Where the shared css/js is served from, and which immutable tag every deck pins. One version for the whole repo — validate.py fails any deck that disagrees.",
          "required": ["baseUrl", "repo", "version"],
          "additionalProperties": false,
          "properties": {
            "baseUrl": { "type": "string", "format": "uri" },
            "repo": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$",
              "description": "owner/name of the public mirror publish-shared.py pushes to."
            },
            "version": {
              "type": "string",
              "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$",
              "description": "Tag on the mirror. Must be a tag, never a branch — a branch ref is re-checked every 12h and edges disagree during the window."
            },
            "join": {
              "type": "string",
              "enum": ["@", "/"],
              "description": "How the version attaches to baseUrl. jsDelivr pins with '@'; a plain bucket path uses '/'."
            }
          }
        },
        "neverDeploy": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
